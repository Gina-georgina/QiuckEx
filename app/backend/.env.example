# =============================================================================
# QuickEx Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables marked as REQUIRED must be set for the application to start.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Port number for the HTTP server (default: 4000)
PORT=4000

# Node environment: development | production | test (default: development)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Network Configuration (REQUIRED)
# -----------------------------------------------------------------------------

# Stellar network to connect to: testnet | mainnet
# Use 'testnet' for development and testing, 'mainnet' for production
NETWORK=testnet

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------

# Supabase project URL (e.g., https://your-project.supabase.co)
# Get this from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=http://127.0.0.1:54321

# Supabase anonymous (public) key
# Get this from: Supabase Dashboard > Project Settings > API > Project API keys
# NOTE: Never commit actual keys to version control
SUPABASE_ANON_KEY=test-anon-key

# Stellar
STELLAR_NETWORK=testnet

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Additional comma-separated origins beyond https://quickex.to,
# https://staging.quickex.to, and http://localhost:3000.
CORS_ALLOWED_ORIGINS=

# Vercel project slug. When set, all preview URLs matching
# https://<slug>-*.vercel.app are automatically allowed.
CORS_VERCEL_PROJECT=quickex-frontend

METRICS_ENDPOINT_PROTECTED=false # Set to true in production
METRICS_ENDPOINT_TOKEN=your-secret-token # If protected

# Recurring Payments Configuration
RECURRING_PAYMENT_MAX_RETRY=3
RECURRING_PAYMENT_RETRY_BACKOFF_MS=60000
RECURRING_PAYMENT_NOTIFICATION_HOURS_BEFORE=24

# -----------------------------------------------------------------------------
# Privacy: data retention & deletion (issue #307)
# Policy of record: docs/policies/DATA-RETENTION-PRIVACY-POLICY.md
# Windows/holds/SLA live in docs/policies/data/retention-schedule.json — do not duplicate them here.
# -----------------------------------------------------------------------------

# Salt used to hash the verified subject of a deletion request.
# REQUIRED in production (intake refuses with RETENTION_POLICY_UNAVAILABLE when unset).
# Use a random 32+ character value stored in your secret manager; never log it.
PRIVACY_SUBJECT_HASH_SALT=change-me-dev-only-salt

# Records processed per category per retention sweep run (bounds latency/blast radius)
PRIVACY_SWEEP_BATCH_SIZE=500

# Extra legal holds, e.g. {"security_incident_active":["abuse_signals"]}
# Only ever adds restrictions; it can never release a policy-defined hold.
PRIVACY_HOLD_OVERRIDES_JSON=

# Last-resort kill switch for deletion-request intake (same style as app/backend/flags.js)
PRIVACY_DELETION_REQUESTS_ENABLED=true

# -----------------------------------------------------------------------------
# Governance (issues #306-#309)
# Policies: docs/policies/*.md · ADRs: docs/adr/ · Gate: node scripts/governance/check.mjs
# -----------------------------------------------------------------------------

# Optional env kill switch for asset listing policy enforcement.
# When explicitly false the backend serves every verified asset (pre-policy behaviour).
ASSET_LISTING_POLICY_ENFORCE=true
STELLAR_SECRET_KEY=your-secret-key-here

# Comma-separated trusted anchor domains for SEP-24 fiat ramps
FIAT_RAMP_ANCHOR_DOMAINS=
FIAT_RAMP_ALLOWED_ANCHOR_DOMAINS=

# -----------------------------------------------------------------------------
# Preview Environment Configuration (Optional)
# -----------------------------------------------------------------------------
# Used by the preview workflow to reproduce a preview deployment locally.
# See .github/workflows for the preview job that consumes these values.

# Scope/namespace for preview resources (e.g., preview, pr-1234).
# Previews are isolated per scope; leave empty for local development.
PREVIEW_SCOPE=

# Inactivity threshold in milliseconds before a preview is considered stale
# and eligible for teardown (default: 3600000 = 1 hour).
PREVIEW_INACTIVITY_THRESHOLD_MS=3600000

# Maximum age in milliseconds a preview may live before forced teardown
# (default: 86400000 = 24 hours).
PREVIEW_MAX_AGE_MS=86400000

# Rate limiting profile to apply: default | preview | strict
# Use 'preview' for preview deployments to allow higher burst limits while
# still protecting shared infrastructure.
RATE_LIMIT_PROFILE=preview

# Supabase project dedicated to preview deployments (optional).
# When unset, the main SUPABASE_URL/SUPABASE_ANON_KEY above are used.
SUPABASE_PREVIEW_URL=
SUPABASE_PREVIEW_ANON_KEY=

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (Optional)
# -----------------------------------------------------------------------------

# Sentry DSN for error reporting. Omit to disable Sentry.
# Get this from: Sentry Dashboard > Project Settings > Client Keys (DSN)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry environment (e.g., production, staging). Falls back to NODE_ENV.
SENTRY_ENVIRONMENT=development

# Sentry release identifier (helps track which version introduced a bug)
SENTRY_RELEASE=quickex-backend@0.1.0

# Performance traces sample rate (0.0 to 1.0). Use lower values in production.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Profiling sample rate (0.0 to 1.0). Use lower values in production.
SENTRY_PROFILES_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# Staging Environment Parity Configuration (Optional)
# -----------------------------------------------------------------------------

# Enable environment parity checks at startup (default: false)
ENV_PARITY_CHECK_ENABLED=false

# Production base URL for parity comparison (staging only)
PRODUCTION_BASE_URL=https://api.quickex.to

# Enable shadow traffic mode for read endpoints (default: false)
# WARNING: Only enable in staging. Never enable in production.
SHADOW_TRAFFIC_ENABLED=false

# Shadow traffic sample rate (0.0 to 1.0, default: 0.1 = 10%)
SHADOW_TRAFFIC_SAMPLE_RATE=0.1

# Comma-separated list of read endpoints to shadow (default: /api/links,/api/transactions,/api/usernames)
SHADOW_TRAFFIC_ENDPOINTS=/api/links,/api/transactions,/api/usernames

# Enable safe test data seeding in staging (default: false)
# WARNING: Only enable in staging. Never enable in production.
STAGING_SEED_DATA_ENABLED=false

# Explicit environment name for parity tracking
# Options: development, staging, production, test
ENVIRONMENT_NAME=development

# Seed Reset Scheduler Configuration
SEED_RESET_ENABLED=true
SEED_RESET_INTERVAL=0 0 * * *
SEED_RESET_EXCLUSIONS=production,mainnet
SEED_RESET_MAX_RETRIES=3
SEED_RESET_RETRY_DELAY_MS=60000
FEATURE_SEED_RESET=true